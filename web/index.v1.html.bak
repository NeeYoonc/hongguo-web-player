<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0e0e12">
<title>红果短剧 · Web</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="topbar">
  <div class="brand">红果短剧<em>Web</em></div>
  <form id="search-form" class="search" autocomplete="off">
    <input id="search-input" type="search" placeholder="搜剧名 / 关键词" enterkeyhint="search">
    <button type="submit" aria-label="搜索">搜索</button>
  </form>
</header>

<nav id="chips" class="chips" aria-label="分类"></nav>

<main>
  <div id="grid" class="grid"></div>
  <div class="more-wrap">
    <button id="more" class="more" hidden>加载更多</button>
    <button id="reset-search" class="more ghost" hidden>返回推荐</button>
  </div>
  <div id="empty" class="empty" hidden>没有找到内容</div>
</main>

<div id="detail" class="sheet" hidden>
  <div class="sheet-panel">
    <button class="close" data-close="detail" aria-label="关闭">×</button>
    <div class="detail-head">
      <img id="d-cover" class="d-cover" alt="">
      <div class="detail-info">
        <h2 id="d-title"></h2>
        <div id="d-meta" class="meta"></div>
        <p id="d-desc" class="desc"></p>
        <div class="detail-actions">
          <button id="d-play" class="primary">开始播放</button>
        </div>
      </div>
    </div>
    <h3 class="section-title">选集</h3>
    <div id="d-chapters" class="chapters"></div>
  </div>
</div>

<div id="player" class="player" hidden>
  <div class="player-stage">
    <video id="video" playsinline preload="metadata"></video>
    <div id="p-danmaku" class="danmaku-layer" aria-hidden="true"></div>
    <div class="player-top">
      <button id="p-back" class="icon-btn" aria-label="返回">‹</button>
      <div class="player-title">
        <div id="p-title"></div>
        <div id="p-sub" class="player-sub"></div>
      </div>
      <button id="p-dm" class="icon-btn" aria-label="弹幕设置">弹</button>
      <button id="p-close" class="icon-btn" aria-label="关闭">×</button>
    </div>
    <div id="p-loading" class="player-loading" hidden>正在取流…</div>
    <div id="p-error" class="player-error" hidden>
      <p id="p-error-text"></p>
      <button id="p-fallback" class="primary" hidden>换一条线路</button>
    </div>
    <div id="dm-panel" class="dm-panel" hidden>
      <label class="dm-row"><input id="dm-on" type="checkbox" checked> 弹幕</label>
      <label class="dm-row">透明度 <input id="dm-opacity" type="range" min="20" max="100" step="5" value="90"></label>
      <label class="dm-row">字号 <input id="dm-size" type="range" min="12" max="30" step="1" value="18"></label>
      <label class="dm-row">速度 <input id="dm-speed" type="range" min="50" max="200" step="10" value="100"></label>
      <label class="dm-row">区域
        <select id="dm-area">
          <option value="full">全屏</option>
          <option value="top">上半屏</option>
          <option value="bottom">下半屏</option>
        </select>
      </label>
      <div class="dm-tip">弹幕来自红果 App 接口</div>
    </div>
    <div class="player-ctrls" id="p-ctrls">
      <div class="ctl-progress">
        <span id="p-time">0:00</span>
        <input id="p-seek" class="seek" type="range" min="0" max="1000" step="1" value="0" aria-label="播放进度">
        <span id="p-dur">0:00</span>
      </div>
      <div class="ctl-buttons">
        <button id="p-play" class="icon-btn" aria-label="播放/暂停">▶</button>
        <button id="p-prev" class="icon-btn" aria-label="上一集">⏮</button>
        <button id="p-next" class="icon-btn" aria-label="下一集">⏭</button>
        <button id="p-mute" class="icon-btn" aria-label="静音">🔊</button>
        <input id="p-vol" class="vol" type="range" min="0" max="100" step="1" value="100" aria-label="音量">
        <span id="p-vol-label" class="vol-label">100%</span>
        <select id="p-quality" class="quality" aria-label="清晰度"></select>
        <label class="auto-next"><input id="p-auto" type="checkbox" checked> 自动连播</label>
        <button id="p-full" class="icon-btn" aria-label="全屏">⛶</button>
      </div>
    </div>
  </div>
  <div id="p-chapters" class="player-chapters"></div>
</div>

<div id="toast" class="toast" hidden></div>
<script src="/app.js"></script>
</body>
</html>
