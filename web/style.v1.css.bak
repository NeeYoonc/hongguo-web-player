:root {
  --bg: #0e0e12;
  --bg-soft: #16161c;
  --panel: #1b1b22;
  --line: #2a2a33;
  --text: #f2f2f5;
  --muted: #9a9aa6;
  --red: #ff3b3b;
  --red-soft: #ff5b5b;
  --radius: 14px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  background: var(--bg);
  color: var(--text);
  font: 14px/1.5 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
  -webkit-font-smoothing: antialiased;
  padding-bottom: 40px;
}
button, input, select { font: inherit; color: inherit; }
button { cursor: pointer; border: 0; background: none; }
img { display: block; }

/* ---------- 顶栏 ---------- */
.topbar {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px calc(12px);
  background: linear-gradient(180deg, rgba(14,14,18,.98) 60%, rgba(14,14,18,.86));
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.brand { font-size: 20px; font-weight: 800; letter-spacing: .5px; white-space: nowrap; }
.brand em { font-style: normal; font-size: 11px; color: var(--red); margin-left: 4px; font-weight: 700; }
.search { display: flex; flex: 1; max-width: 560px; margin-left: auto; }
.search input {
  flex: 1; min-width: 0; height: 36px; padding: 0 12px;
  background: var(--bg-soft); border: 1px solid var(--line); border-radius: 10px 0 0 10px;
  outline: none;
}
.search input:focus { border-color: var(--red); }
.search button {
  height: 36px; padding: 0 16px; border-radius: 0 10px 10px 0;
  background: var(--red); color: #fff; font-weight: 600;
}

/* ---------- 分类 ---------- */
.chips {
  display: flex; gap: 8px; overflow-x: auto; padding: 12px 16px;
  scrollbar-width: none; position: sticky; top: 61px; z-index: 15;
  background: var(--bg);
}
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: none; padding: 6px 14px; border-radius: 999px;
  background: var(--bg-soft); border: 1px solid var(--line); color: var(--muted);
  white-space: nowrap;
}
.chip.active { background: var(--red); border-color: var(--red); color: #fff; font-weight: 600; }

/* ---------- 列表 ---------- */
main { padding: 4px 16px 24px; }
.grid {
  display: grid; gap: 14px;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
}
.card { cursor: pointer; }
.card .cover-wrap {
  position: relative; aspect-ratio: 3 / 4; border-radius: var(--radius); overflow: hidden;
  background: linear-gradient(135deg, #232330, #17171d);
  border: 1px solid var(--line);
}
.card img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s; }
.card:hover img { transform: scale(1.04); }
.card .badge {
  position: absolute; left: 8px; bottom: 8px;
  padding: 2px 8px; border-radius: 999px; font-size: 11px;
  background: rgba(0,0,0,.66); backdrop-filter: blur(4px); color: #fff;
}
.card .badge.vip { background: rgba(255,59,59,.86); }
.card h3 {
  margin: 8px 2px 0; font-size: 13px; font-weight: 600; line-height: 1.35;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}
.card .sub { margin: 2px 2px 0; color: var(--muted); font-size: 11px; }
.more-wrap { display: flex; justify-content: center; gap: 12px; padding: 22px 0 8px; }
.more {
  padding: 10px 26px; border-radius: 999px;
  background: var(--bg-soft); border: 1px solid var(--line); color: var(--text);
}
.more.ghost { color: var(--muted); }
.empty { text-align: center; color: var(--muted); padding: 60px 0; }

/* ---------- 详情 ---------- */
.sheet {
  position: fixed; inset: 0; z-index: 40;
  background: rgba(0,0,0,.62); backdrop-filter: blur(6px);
  display: flex; align-items: flex-end; justify-content: center;
  padding: 0;
}
.sheet-panel {
  position: relative; width: 100%; max-width: 860px; max-height: 92vh; overflow-y: auto;
  background: var(--panel); border-radius: 20px 20px 0 0; padding: 20px 18px 26px;
  border: 1px solid var(--line); border-bottom: 0;
}
.close {
  position: absolute; right: 12px; top: 10px; z-index: 2;
  width: 34px; height: 34px; border-radius: 50%; font-size: 20px;
  background: rgba(0,0,0,.4); color: var(--muted);
}
.detail-head { display: flex; gap: 14px; }
.d-cover {
  width: 108px; aspect-ratio: 3 / 4; border-radius: 12px; object-fit: cover;
  background: var(--bg-soft); border: 1px solid var(--line); flex: none;
}
.detail-info { min-width: 0; flex: 1; }
.detail-info h2 { margin: 0 0 6px; font-size: 19px; line-height: 1.3; }
.meta { color: var(--muted); font-size: 12px; display: flex; flex-wrap: wrap; gap: 6px 12px; }
.meta .tag { padding: 1px 8px; border-radius: 6px; background: var(--bg-soft); border: 1px solid var(--line); }
.desc {
  color: var(--muted); font-size: 13px; margin: 10px 0 0;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}
.detail-actions { margin-top: 12px; }
.primary {
  padding: 10px 22px; border-radius: 10px; background: var(--red); color: #fff; font-weight: 700;
}
.primary:disabled { opacity: .5; }
.section-title { margin: 22px 0 10px; font-size: 15px; }
.chapters { display: grid; grid-template-columns: repeat(auto-fill, minmax(58px, 1fr)); gap: 8px; }
.chapter {
  padding: 9px 0; border-radius: 9px; text-align: center; font-size: 13px;
  background: var(--bg-soft); border: 1px solid var(--line); color: var(--text);
}
.chapter.watched { color: var(--muted); }
.chapter.active { background: var(--red); border-color: var(--red); color: #fff; font-weight: 700; }

/* ---------- 播放器 ---------- */
.player {
  position: fixed; inset: 0; z-index: 60; background: #000;
  display: flex; flex-direction: column;
}
.player-stage { position: relative; flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; }
.player video { width: 100%; height: 100%; object-fit: contain; background: #000; }
.player-top {
  z-index: 6; position: absolute; left: 0; right: 0; top: 0; display: flex; align-items: center; gap: 10px;
  padding: 10px 12px; background: linear-gradient(180deg, rgba(0,0,0,.72), transparent);
  pointer-events: none;
}
.player-top > * { pointer-events: auto; }
.icon-btn {
  width: 38px; height: 38px; border-radius: 50%; font-size: 18px; color: #fff;
  background: rgba(255,255,255,.12); display: grid; place-items: center; flex: none;
}
.player-title { min-width: 0; flex: 1; }
#p-title { font-size: 15px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-shadow: 0 1px 4px rgba(0,0,0,.8); }
.player-sub { font-size: 12px; color: rgba(255,255,255,.72); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-ctrls {
  z-index: 7; position: absolute; left: 0; right: 0; bottom: 0;
  padding: 18px 14px 12px;
  background: linear-gradient(0deg, rgba(0,0,0,.86), rgba(0,0,0,.35) 65%, transparent);
  transition: opacity .25s ease;
}
.player-ctrls.hide { opacity: 0; pointer-events: none; }
.ctl-progress { display: flex; align-items: center; gap: 10px; font-size: 12px; color: rgba(255,255,255,.85); }
.seek { flex: 1; height: 20px; accent-color: var(--red); cursor: pointer; }
.ctl-buttons { display: flex; align-items: center; gap: 10px; margin-top: 6px; flex-wrap: wrap; row-gap: 8px; }
.vol { width: 84px; height: 20px; accent-color: var(--red); cursor: pointer; }
.vol-label { font-size: 12px; color: rgba(255,255,255,.75); min-width: 36px; text-align: right; }
.quality {
  margin-left: auto; height: 34px; padding: 0 8px; border-radius: 8px;
  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
}
.quality option { background: #1b1b22; }
.auto-next { display: flex; align-items: center; gap: 5px; font-size: 12px; color: rgba(255,255,255,.8); }
.player-loading, .player-error {
  z-index: 5; position: absolute; inset: 0; display: flex; flex-direction: column; gap: 14px;
  align-items: center; justify-content: center; background: rgba(0,0,0,.55); text-align: center; padding: 20px;
}
/* 加载/错误浮层不能挡住 video 原生控件（自动播放被拦时可手动点播放） */
.player-loading { pointer-events: none; }
.player-error { pointer-events: none; }
.player-error button { pointer-events: auto; }
.player-error p { color: #ffb4b4; max-width: 480px; }
.player-chapters {
  flex: none; display: flex; gap: 8px; overflow-x: auto; padding: 10px 12px 14px;
  background: #08080b; border-top: 1px solid #1a1a20;
}
.player-chapters .chapter { flex: none; min-width: 52px; padding: 7px 10px; }
.player-chapters .chapter.active { background: var(--red); }

/* ---------- toast ---------- */
.toast {
  position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%);
  background: rgba(40,40,48,.96); border: 1px solid var(--line); color: var(--text);
  padding: 10px 18px; border-radius: 10px; z-index: 100; max-width: 86vw;
  box-shadow: 0 8px 30px rgba(0,0,0,.5);
}

@media (min-width: 720px) {
  .sheet { align-items: center; padding: 24px; }
  .sheet-panel { border-radius: 20px; border-bottom: 1px solid var(--line); max-height: 86vh; }
  .grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
}

/* hidden 属性优先级：作者样式里的 display:flex 会覆盖浏览器默认的 [hidden]{display:none}，统一兜底 */
[hidden] { display: none !important; }

/* 全屏时只保留画面 + 悬浮控制条（隐藏标题栏与剧集条） */
#player:fullscreen { background: #000; }
#player:fullscreen .player-top,
#player:fullscreen .player-chapters { display: none; }
#player:-webkit-full-screen .player-top,
#player:-webkit-full-screen .player-chapters { display: none; }

/* ---------- 弹幕 ---------- */
.danmaku-layer {
  position: absolute; inset: 0; overflow: hidden; pointer-events: none;
  transition: opacity .2s ease; z-index: 2;
}
.danmaku-layer.off { display: none; }
.danmaku-layer.area-top { bottom: 50%; }
.danmaku-layer.area-bottom { top: 50%; }
.dm {
  position: absolute; left: 100%; top: 0; white-space: nowrap;
  color: #fff; font-weight: 700; line-height: 1.25;
  text-shadow: 0 1px 2px rgba(0,0,0,.9), 0 0 6px rgba(0,0,0,.55);
  animation: dm-move var(--dm-dur, 8s) linear forwards;
  will-change: transform;
}
.danmaku-layer.paused .dm { animation-play-state: paused; }
@keyframes dm-move {
  from { transform: translateX(0); }
  to { transform: translateX(var(--dm-dist, -1200px)); }
}
.dm-panel {
  position: absolute; right: 14px; bottom: 86px; z-index: 8;
  width: 232px; padding: 12px 14px; border-radius: 12px;
  background: rgba(20,20,26,.96); border: 1px solid rgba(255,255,255,.14);
  box-shadow: 0 10px 30px rgba(0,0,0,.5); font-size: 13px;
}
.dm-row { display: flex; align-items: center; gap: 8px; margin: 7px 0; color: rgba(255,255,255,.9); }
.dm-row input[type="range"] { flex: 1; accent-color: var(--red); }
.dm-row input[type="checkbox"] { accent-color: var(--red); }
.dm-row select { margin-left: auto; background: #26262e; color: #fff; border: 1px solid rgba(255,255,255,.16); border-radius: 7px; padding: 3px 6px; }
.dm-tip { margin-top: 8px; font-size: 11px; color: rgba(255,255,255,.45); }
